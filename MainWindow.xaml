<Window x:Class="AiVoiceBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Voice Bridge" Icon="Assets/VoiceBridge.ico" Width="700" Height="715" MinWidth="640" MinHeight="440" Background="#19191F" Foreground="#EAE8F2" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Deactivated="Window_Deactivated" Closing="Window_Closing">
<Grid Margin="24,18,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,10"><StackPanel><TextBlock Text="AI Voice Bridge" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Создано by ridfers" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#352C43" CornerRadius="5" Padding="9,4"><TextBlock Text="WASAPI · 0.2" FontSize="10" Foreground="#C8AFE9" FontWeight="SemiBold"/></Border></Grid>
<TabControl Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">
<TabItem Header="Главная"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Что слышит нейросеть" FontWeight="SemiBold"/>
<ComboBox ItemsSource="{Binding CaptureChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Settings.CaptureSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseSource}" AutomationProperties.Name="Источник звука для нейросети"/>
<TextBlock Text="{Binding CaptureHint}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
<Border Style="{StaticResource Card}" Padding="13"><StackPanel>
<Grid><StackPanel><TextBlock Text="СОСТОЯНИЕ МОСТА" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,9,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="19" FontWeight="SemiBold"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Уровень на выбранном источнике браузера. Другой звук на этом канале тоже включает индикатор. Обновление 10 раз в секунду только при видимом окне."><Ellipse Width="9" Height="9" Fill="{Binding AiVoiceColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding AiVoiceLabel}" FontSize="11" Foreground="{Binding AiVoiceColor}" VerticalAlignment="Center"/></StackPanel><Border Background="#302C3B" CornerRadius="5" Padding="10,6"><TextBlock Text="{Binding Settings.Hotkey}" FontWeight="SemiBold" Foreground="#D2BEEE"/></Border></StackPanel></Grid>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Аудиомаршрут" Style="{StaticResource Caption}"/><TextBlock Text="{Binding RouteStatus}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Игровой звук → ИИ" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TransmissionStatus}" Margin="0,4,0,0"/></StackPanel></Grid>
<TextBlock Text="{Binding ConnectionDetail}" Visibility="{Binding ConnectionDetailVisibility}" Foreground="#EC9B9B" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
<Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Мой микрофон" Style="{StaticResource Caption}"/><ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding MicLevel.Level,Mode=OneWay}" Foreground="{Binding MicLevel.Color}" Background="#3A3644" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding MicLevel.Label}" Foreground="{Binding MicLevel.Color}" FontSize="10" Margin="10,0,0,0"/></Grid>
<Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Звук для ИИ" Style="{StaticResource Caption}"/><ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding ToAiLevel.Level,Mode=OneWay}" Foreground="{Binding ToAiLevel.Color}" Background="#3A3644" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding ToAiLevel.Label}" Foreground="{Binding ToAiLevel.Color}" FontSize="10" Margin="10,0,0,0"/></Grid>
<Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Голос ИИ" Style="{StaticResource Caption}"/><ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding AiLevel.Level,Mode=OneWay}" Foreground="{Binding AiLevel.Color}" Background="#3A3644" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding AiLevel.Label}" Foreground="{Binding AiLevel.Color}" FontSize="10" Margin="10,0,0,0"/></Grid>
<TextBlock Text="Красный — перегруз / близко к пределу. Уменьшите громкость этого канала." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
</StackPanel></Border>
<WrapPanel Margin="0,12,0,0"><Button Content="{Binding StartLabel}" Command="{Binding ToggleCommand}" Background="#796195" MinWidth="132"/><Button Content="Открыть ChatGPT ↗" Command="{Binding OpenChatGptCommand}"/><Button Content="Проверить звук" Command="{Binding SoundCheckCommand}"/><Button Content="Отключить всё" Command="{Binding ErrorCommand}"/></WrapPanel>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
<Button x:Name="DemoHold" Content="Удерживать для передачи" Margin="0,0,8,0" IsEnabled="{Binding IsRunning}" PreviewMouseLeftButtonDown="Demo_Down" PreviewMouseLeftButtonUp="Demo_Up" LostMouseCapture="Demo_Release" PreviewKeyDown="Demo_KeyDown" PreviewKeyUp="Demo_KeyUp" LostKeyboardFocus="Demo_Release"/>
<Button Grid.Column="1" Content="{Binding ManualTransmissionLabel}" Command="{Binding ManualTransmissionCommand}" Background="{Binding ManualTransmissionColor}" IsEnabled="{Binding IsRunning}" Margin="0" ToolTip="Одно нажатие включает передачу, следующее выключает. Передача продолжается в фоне."/>
</Grid>
<TextBlock Text="MOUSE5 — удержание. Кнопка справа — передача до повторного нажатия." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
<Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding MicrophoneLabel}" Background="{Binding MicrophoneColor}" Command="{Binding MicrophoneCommand}" IsEnabled="{Binding MicrophoneAvailable}" ToolTip="{Binding MicrophoneHint}" AutomationProperties.Name="{Binding MicrophoneLabel}"/><TextBlock Grid.Column="1" Text="{Binding MicrophoneName}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Аудио"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Микрофон для игрового маршрута B2" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Microphones}" SelectedValuePath="Id" SelectedValue="{Binding Settings.PhysicalMicrophone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Физический микрофон для переключения голоса в игре"/>
<Button Content="Применить схему Voicemeeter Potato" Command="{Binding VoicemeeterCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="Списки содержат устройства воспроизведения. Для микрофона браузера выбирайте парный выход виртуального кабеля." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Выход для режима «Все приложения»"/><ComboBox IsEnabled="{Binding WholeChannel}" ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding Settings.GameSource}" SelectionChanged="Audio_SelectionChanged" AutomationProperties.Name="Источник игрового звука"/>
<TextBlock Text="Выход в микрофон ChatGPT"/><ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding Settings.BrowserMicrophone}" SelectionChanged="Audio_SelectionChanged" AutomationProperties.Name="Выход в виртуальный микрофон ChatGPT"/>
<TextBlock Text="Вывод в наушники"/><ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding Settings.Headphones}" SelectionChanged="Audio_SelectionChanged" AutomationProperties.Name="Устройство вывода в наушники"/>
<TextBlock Text="{Binding Settings.GameVolume, StringFormat=Игровой звук → ИИ: {0:0}%}"/><Slider Maximum="300" Value="{Binding Settings.GameVolume}" AutomationProperties.Name="Громкость игрового звука для ИИ, 100 процентов без усиления"/>
</StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Источник звука браузера"/><ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding Settings.BrowserSource}" SelectionChanged="Audio_SelectionChanged" AutomationProperties.Name="Источник звука браузера"/>
<TextBlock Text="Виртуальный микрофон CS2 / Dota 2"/><ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding Settings.GameMicrophone}" SelectionChanged="Audio_SelectionChanged" AutomationProperties.Name="Виртуальный микрофон для игры"/>
<TextBlock Text="MOUSE4 остаётся игровым Push-to-Talk." Style="{StaticResource Caption}" Margin="0,8,0,28"/>
<TextBlock Text="{Binding Settings.VoiceVolume, StringFormat=Голос ИИ: {0:0}%}"/><Slider IsEnabled="{Binding Settings.RouteVoice}" Value="{Binding Settings.VoiceVolume}" AutomationProperties.Name="Громкость голоса ИИ"/>
</StackPanel></Grid>
<TextBlock Text="Если голос уже идёт через AUX → B2 в Voicemeeter, оставьте дополнительные маршруты ниже выключенными. Его громкость регулируется в Voicemeeter." Style="{StaticResource Caption}"/><CheckBox Content="Передавать голос браузера в игровой микрофон" IsChecked="{Binding Settings.RouteVoice}" Click="Route_Changed"/><CheckBox Content="Слышать голос браузера в наушниках" IsChecked="{Binding Settings.MonitorVoice}" Click="Route_Changed"/><CheckBox Content="Слышать отдельный игровой источник в наушниках" IsChecked="{Binding Settings.MonitorGame}" Click="Route_Changed"/><ComboBox ItemsSource="{Binding MicModes}" SelectedItem="{Binding Settings.GameMicMode}"/><TextBlock Text="Для тиммейтов удерживайте MOUSE4 или включите штатный открытый микрофон игры, если доступен. Программа не открывает игровой микрофон." Style="{StaticResource Caption}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Проверка маршрутов" FontWeight="SemiBold"/><TextBlock Text="{Binding LoopStatus}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
<Button Content="Обновить / проверить устройства" Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,10,0,8"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Style="{StaticResource Card}" Padding="13"><Grid><StackPanel><TextBlock Text="Глобальная клавиша передачи" FontWeight="SemiBold"/><TextBlock Text="MOUSE4 не переназначается и не блокируется." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Content="Переназначить…" Command="{Binding RemapCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
<TextBlock Text="Параметры запуска и трея" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
<ComboBox ItemsSource="{Binding Hotkeys}" SelectedItem="{Binding Settings.Hotkey}" AutomationProperties.Name="Глобальная клавиша"/><CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding Settings.StartWithWindows}"/>
<CheckBox Content="Сворачивать в системный трей" IsChecked="{Binding Settings.MinimizeToTray}"/>
<CheckBox Content="Запускать в свёрнутом состоянии" IsChecked="{Binding Settings.StartMinimized}"/>
<CheckBox Content="Сохранять настройки между запусками" IsChecked="{Binding Settings.SaveSettings}"/>
<WrapPanel Margin="0,9,0,0"><Button Content="Сохранить настройки" Command="{Binding SaveCommand}"/><Button Content="Аварийное отключение" Command="{Binding EmergencyCommand}" Background="#633E49"/></WrapPanel>
<TextBlock Text="Версия 0.2.0 · by ridfers · .NET 10 / WPF" Style="{StaticResource Caption}" Margin="0,12,0,8"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Помощь"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Как настроить мост" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock LineHeight="25" Text="1. Установить и настроить виртуальные аудиоустройства.&#10;2. Открыть ChatGPT в браузере.&#10;3. Выбрать виртуальный микрофон в браузере.&#10;4. Вручную запустить голосовой режим ChatGPT.&#10;5. Удерживать MOUSE5 для передачи игрового звука.&#10;6. Отпустить MOUSE5, чтобы прекратить передачу.&#10;Без удержания: нажать «Включить передачу», затем «Выключить передачу»."/>
<Border Style="{StaticResource Card}" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="Без OpenAI API" FontWeight="SemiBold" Foreground="#C8AFE9"/><TextBlock Text="ChatGPT сам определяет окончание реплики и момент ответа. Приложение не управляет голосовым режимом браузера." Margin="0,6,0,0"/></StackPanel></Border>
<TextBlock Text="На главной выберите Discord, CS2 или Dota 2 для захвата только этого приложения. «Все приложения» захватывает микс выбранного аудиовыхода. После смены источника запустите мост снова. Предупредите участников чата о передаче речи в ИИ. Подробная схема — в README." Style="{StaticResource Caption}" Margin="0,12,0,8"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl>
<Border Grid.Row="2" BorderBrush="#302D3A" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" MaxHeight="34" AutomationProperties.LiveSetting="Polite"/></Border>
</Grid></Window>














